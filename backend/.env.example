# ─────────────────────────────────────────────────────────────
#  Classroom Attendance – Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Your project URL (e.g. https://xyzxyzxyz.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# "anon" public key (safe for client SDKs)
SUPABASE_ANON_KEY=your-anon-key-here

# "service_role" secret key (NEVER expose this to clients – backend only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret for verifying Supabase-issued tokens
# Find in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Application ───────────────────────────────────────────────
ATTENDANCE_ENV=development

# Token / WebSocket settings
ATTENDANCE_TOKEN_TTL_SECONDS=28800
ATTENDANCE_WS_TICKET_TTL_SECONDS=60
ATTENDANCE_MAX_SESSION_MINUTES=60
ATTENDANCE_SESSION_CLOSE_POLL_SECONDS=1
ATTENDANCE_LOGIN_RATE_LIMIT=10
ATTENDANCE_LOGIN_RATE_WINDOW_SECONDS=60
ATTENDANCE_SUBMIT_RATE_LIMIT=10
ATTENDANCE_SUBMIT_RATE_WINDOW_SECONDS=60

# Verification models are backend-only files; do not commit model weights.
ATTENDANCE_YUNET_MODEL_PATH=private-models/face_detection_yunet.onnx
ATTENDANCE_ARCFACE_MODEL_PATH=private-models/arcface.onnx
ATTENDANCE_FACE_MODEL_VERSION=yunet-arcface-v1
ATTENDANCE_TEMPLATE_ENCRYPTION_KEY=replace-with-a-generated-Fernet-key
ATTENDANCE_EVIDENCE_BUCKET=attendance-evidence
ATTENDANCE_FLAGGED_RETENTION_DAYS=7

# Allowed CORS origins (comma-separated)
ATTENDANCE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

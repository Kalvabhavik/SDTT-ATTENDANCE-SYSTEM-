# Application configuration. Set a strong secret (at least 32 characters) for your environment.
# Generate one using: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ATTENDANCE_APP_SECRET=dev_secure_attendance_secret_key_at_least_32_chars_long
ATTENDANCE_ENV=development
ATTENDANCE_DB_PATH=./data/attendance.sqlite3
ATTENDANCE_TOKEN_TTL_SECONDS=28800
ATTENDANCE_WS_TICKET_TTL_SECONDS=60
ATTENDANCE_MAX_CAPTURE_BYTES=10485760
ATTENDANCE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

